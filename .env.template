# ============================================================
# Brain Graph — Environment Variables Template
# Copy to .env and fill in your values
# ============================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key_here

# --- Voyage AI (multilingual embeddings) ---
# Free key: https://dash.voyageai.com/  (200M tokens free)
VOYAGE_API_KEY=your_voyage_api_key_here

# --- Neo4j ---
# Local Docker: bolt://localhost:7687 (user neo4j).
# Neo4j Aura (cloud, for Vercel): neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# --- Auth ---
# REQUIRED in production. Generate a strong random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be IDENTICAL on every backend that shares a database (local + Vercel),
# otherwise a token issued by one is rejected by the other.
JWT_SECRET=change_me_to_a_long_random_string
JWT_TTL_DAYS=30

# --- App ---
APP_ENV=development          # development | production (prod enforces a strong JWT_SECRET)
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# Run the idempotent schema bootstrap on startup. Leave true locally.
# On serverless (Vercel) set false after creating the schema once:
#   python -m src.schema_setup   (see DEPLOY.md §5)
RUN_SCHEMA_SETUP=true

# --- Linking thresholds ---
COSINE_SIMILARITY_THRESHOLD=0.75
TEMPORAL_PROXIMITY_DAYS=90
LINK_STRENGTH_MIN=0.3
